# CognoDB connection details.
#
# Copy this file to .env.local and fill in the values from the CognoDB console
# (https://console.cognodb.com). .env.local is git-ignored — the real password
# must never be committed. In production these are set as environment
# variables on the host (Project Settings → Environment Variables on Vercel).

# The Bolt endpoint shown on your instance page. bolt+s:// enables TLS with
# certificate verification, which is what a managed instance requires.
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud

# CognoDB provisions a single user called "cognodb".
COGNODB_USERNAME=cognodb

# Shown exactly once, when the instance is created. If you lost it, rotate the
# password from the console rather than guessing.
COGNODB_PASSWORD=

# The database inside the instance. Leave as "neo4j" unless you created another.
COGNODB_DATABASE=neo4j
